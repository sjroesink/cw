{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "commonjs", "moduleResolution": "node",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
